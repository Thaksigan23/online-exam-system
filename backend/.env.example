MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority
PORT=5000
JWT_SECRET=change_me_to_a_long_random_string
EMAIL_USER=
EMAIL_PASS=
SMTP_PORT=587

# Comma-separated browser origins allowed to call this API (CORS).
# Example: https://myapp.vercel.app,http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Optional: max /api/auth requests per IP per 15 minutes (default 100)
# AUTH_RATE_LIMIT_MAX=100

NODE_ENV=development
